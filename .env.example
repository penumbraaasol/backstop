# --- Arc testnet ---
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# Official USDC ERC-20 on Arc testnet (6 decimals). Native gas USDC is 18 decimals; same balance.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
BACKSTOP_ADDRESS=
BACKSTOP_DEPLOY_BLOCK=

# --- Keys (never commit real values) ---
PRIVATE_KEY_DEPLOYER=
PRIVATE_KEY_SIGNER=
PRIVATE_KEY_RESOLVER=

# --- Contract config used by the deploy script (USDC, whole units) ---
MAX_PAYOUT_PER_POLICY=1000
MAX_EXPOSURE_PER_MARKET=5000
REFUND_GRACE_PERIOD_SECONDS=86400
TREASURY_SEED_USDC=0

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_BASE_URL=https://api.gemini.com
# live | sandbox | simulated
HEDGE_MODE=simulated
MAX_LIVE_CONTRACTS=5

# --- Cover assistant (optional): Grok suggests a policy, the buyer still signs ---
GROK_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning

# --- Pricing ---
SPREAD=0.03
MAX_SLIPPAGE=0.02
